# Sao chép file này thành .env.local (chạy máy cục bộ) hoặc đặt trong Settings > Environment Variables của Vercel.
# TUYỆT ĐỐI không ghi thông tin thật vào file này vì nó được commit lên git.

# Chuỗi kết nối MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/phongtrieu?retryWrites=true&w=majority

# Tên miền chính thức của website (BẮT BUỘC để sinh/xuất mã QR; in lên tem).
# Trên môi trường thật phải là https và không phải localhost. Đổi giá trị cần deploy lại.
NEXT_PUBLIC_APP_URL=https://<ten-mien-chinh-thuc>

# Tài khoản quản trị (BẮT BUỘC, không có giá trị mặc định trong mã nguồn)
ADMIN_USER=<ten-dang-nhap-quan-tri>
ADMIN_PASS=<mat-khau-manh-duy-nhat>

# Khóa ký phiên đăng nhập, tối thiểu 32 ký tự ngẫu nhiên. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=<chuoi-ngau-nhien-dai-it-nhat-32-ky-tu>

# Gửi email thông báo khách hàng mới liên hệ (Gmail).
# Cần bật xác minh 2 bước cho tài khoản Gmail rồi tạo "Mật khẩu ứng dụng" (App password) 16 ký tự:
#   https://myaccount.google.com/apppasswords   (KHÔNG dùng mật khẩu đăng nhập Gmail)
# Thiếu hai biến này thì khách vẫn gửi được lời nhắn (lưu vào cơ sở dữ liệu) nhưng không có email thông báo.
SMTP_EMAIL=<dia-chi-gmail-dung-de-gui>
SMTP_PASSWORD=<mat-khau-ung-dung-gmail>
# (Tùy chọn) Người nhận thông báo; mặc định mamdisanphongtrieu@gmail.com
# CONTACT_NOTIFY_EMAIL=
